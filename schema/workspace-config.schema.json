{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Context Linker private workspace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "projects", "relationships"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "workspace": {"$ref": "context-manifest.schema.json#/$defs/workspace"},
    "projects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/projectSource"}},
    "skill_roots": {"type": "array", "items": {"$ref": "#/$defs/skillRoot"}},
    "review_state_files": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "session_summary_files": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "relationship_candidate_files": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "relationships": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "context-manifest.schema.json#/$defs/relationship"},
          {"required": ["layer"]}
        ]
      }
    }
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 4000},
    "skillRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "scope", "path"],
      "properties": {
        "id": {"$ref": "context-manifest.schema.json#/$defs/identifier"},
        "provider": {"$ref": "context-manifest.schema.json#/$defs/identifier"},
        "scope": {"enum": ["user", "workspace", "custom"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 4000},
        "approved_summaries": {
          "type": "object",
          "additionalProperties": {"$ref": "context-manifest.schema.json#/$defs/safeString"}
        }
      }
    },
    "projectSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {"$ref": "context-manifest.schema.json#/$defs/identifier"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4000},
        "registry_key": {"type": "string", "pattern": "^(git-origin|path)-sha256:[0-9a-f]{64}$"},
        "name": {"$ref": "context-manifest.schema.json#/$defs/safeString"},
        "summary": {"$ref": "context-manifest.schema.json#/$defs/safeString"},
        "status": {"$ref": "context-manifest.schema.json#/$defs/safeString"},
        "sensitivity": {"enum": ["public", "internal", "private", "highly-sensitive"]},
        "cloud_visibility": {"enum": ["allow", "summary-only", "deny"], "default": "deny"},
        "redaction_profile": {"$ref": "context-manifest.schema.json#/$defs/identifier"},
        "approved_summary": {"$ref": "context-manifest.schema.json#/$defs/safeString"},
        "allow_files": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}},
        "attach_files": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
        "dependency_files": {
          "type": "array",
          "items": {"enum": ["pyproject.toml", "package.json", "Cargo.toml", "go.mod"]}
        },
        "observe_paths": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}},
        "state_files": {
          "type": "array",
          "items": {"enum": ["STATUS.md", "progress.md", "task_plan.md", "findings.md", "ROADMAP.md", "DECISIONS.md"]}
        },
        "state_file_candidates": {
          "type": "array",
          "items": {"enum": ["STATUS.md", "progress.md", "task_plan.md", "findings.md", "ROADMAP.md", "DECISIONS.md"]}
        },
        "constraints": {"$ref": "context-manifest.schema.json#/$defs/safeStringArray"},
        "code_relationship_scan": {"type": "boolean", "default": false},
        "architecture_visibility": {
          "enum": ["disabled", "modules-only", "modules-symbols"],
          "default": "disabled"
        },
        "risks": {"$ref": "context-manifest.schema.json#/$defs/safeStringArray"},
        "open_questions": {"$ref": "context-manifest.schema.json#/$defs/safeStringArray"}
      },
      "allOf": [
        {
          "if": {"required": ["attach_files"], "properties": {"attach_files": {"minItems": 1}}},
          "then": {"required": ["cloud_visibility"], "properties": {"cloud_visibility": {"const": "allow"}}}
        },
        {
          "if": {"properties": {"cloud_visibility": {"enum": ["allow", "summary-only"]}}, "required": ["cloud_visibility"]},
          "then": {"required": ["sensitivity", "redaction_profile"]}
        },
        {
          "if": {"properties": {"cloud_visibility": {"const": "summary-only"}}, "required": ["cloud_visibility"]},
          "then": {"required": ["approved_summary"]}
        }
      ]
    }
  }
}
